# Optional canonical URL. On Netlify, the site's URL is used automatically.
# Set this to your custom domain when you connect one, then rebuild.
# SITE_URL=https://your-domain.example

# Required for contact form delivery. This public key is included in browser JS.
# Get your Web3Forms access key at https://web3forms.com.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Optional admin access. Set all three to enable login; otherwise access is disabled.
# Store these as server-side environment variables, never NEXT_PUBLIC_ variables.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Use a random value of at least 32 characters.
ADMIN_SESSION_SECRET=
